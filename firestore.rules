// Правила Firestore проекта «Табель смены» — вставить в консоли Firebase: Firestore Database → Rules → Publish.
// Табель: каждый видит и пишет только свою папку users/<его uid>. Планировщики GitHub ходят ключом сервисного аккаунта —
// он правила обходит.
// Продукция: страницу /work/ открывают работники смены под общим логином (почта вида smena1@tabel-smeny.app) —
// им доступны только shipments и список видов продукции; табеля и настроек бота они не видят.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() { return request.auth != null && request.auth.uid == 'ngguawiypAgBzow5UKhHqoKCcXs2'; }
    function worker() { return request.auth != null && request.auth.token.email in ['smena1@tabel-smeny.app']; }
    function okShipment(d) {
      return d.keys().hasOnly(['shift', 'qty', 'product', 'color', 'unit', 'machine', 'noHoles', 'at', 'by', 'createdAt'])
        && d.shift is string && d.shift.size() <= 20
        && d.qty is number && d.qty > 0 && d.qty <= 100000
        && (!('noHoles' in d) || d.noHoles is bool)
        && (!('machine' in d) || (d.machine is string && d.machine.size() <= 20))
        && (!('unit' in d) || d.unit in ['коробок', 'штук'])
        && d.product is string && d.product.size() > 0 && d.product.size() <= 80
        && (!('color' in d) || (d.color is string && d.color.size() <= 40))
        && d.at is string && d.at.size() <= 40;
    }

    match /users/{uid}/apps/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /shipments/{id} {
      allow read, delete: if owner() || worker();
      allow create, update: if (owner() || worker()) && okShipment(request.resource.data);
    }

    // Списки видов продукции и цветов для выпадающих списков: правит владелец, работники читают
    match /settings/production {
      allow read: if owner() || worker();
      allow write: if owner();
    }
  }
}
